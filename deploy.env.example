# ════════════════════════════════════════════════════════════════════
#  Deployment configuration
#
#    cp deploy.env.example deploy.env
#
#  Then edit the values below and run:
#    ./scripts/setup-gcp.sh      (once)
#    ./scripts/deploy-backend.sh (every deploy)
#
#  deploy.env is gitignored. It holds NO secrets — the actual secrets live
#  in Google Secret Manager, created for you by setup-gcp.sh.
# ════════════════════════════════════════════════════════════════════

# ── Google Cloud ─────────────────────────────────────────────────────

# Your project ID (NOT the display name). Find it with:
#   gcloud projects list
# Must be globally unique if you are creating a new one.
GCP_PROJECT_ID=my-attendance-project

# asia-south1 is Mumbai. Pick the region closest to your classrooms —
# this is 250-300ms of round-trip latency for students, on every request.
#   asia-south1      Mumbai
#   asia-southeast1  Singapore
#   europe-west1     Belgium
#   us-central1      Iowa
GCP_REGION=asia-south1

# Cloud Run service name. Becomes part of the URL:
#   https://<SERVICE_NAME>-<hash>-<region>.a.run.app
SERVICE_NAME=snp-attendance

# Cloud Storage bucket for the face gallery. Bucket names are GLOBALLY
# unique across all of Google Cloud, so prefix it with something of yours.
# This bucket is created private, with public access prevention on.
GCS_BUCKET=my-university-snp-gallery

# Runtime service account name (not the full email — the script builds that).
SA_NAME=snp-runtime


# ── Google Sheets (optional) ─────────────────────────────────────────

# The attendance spreadsheet ID, from its URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
#
# Leave blank to disable Sheets export entirely. Attendance is still
# recorded server-side and downloadable as CSV from the faculty portal —
# a Sheets outage can never block a class.
#
# You MUST share the sheet with the runtime service account as an Editor:
#   snp-runtime@<GCP_PROJECT_ID>.iam.gserviceaccount.com
SHEET_ID=

# Tab name and columns the export appends to. The tab must already exist.
SHEET_RANGE=Attendance!A:G


# ── Frontend origins (CORS) ──────────────────────────────────────────

# The faculty portal runs on Cloudflare Pages — a DIFFERENT origin from the
# backend — so it must be allow-listed or every request is blocked.
#
# Fill this in AFTER the first Pages deploy, then re-run deploy-backend.sh.
# Comma-separated, exact origins, no trailing slash, no "*".
#
# Include both the *.pages.dev URL and any custom domain.
FACULTY_ORIGIN=https://snp-faculty.pages.dev

# The student scanner is served BY the backend (same origin), so it needs
# no entry here. See docs/DEPLOYMENT.md for why it is not on Pages.


# ── Scaling ──────────────────────────────────────────────────────────

# Instances. Cloud Run runs one request per instance (concurrency=1) because
# the ONNX verifier is single-threaded — so MAX_INSTANCES is effectively your
# peak simultaneous verifications.
#   ~200 students  ->  5
#   ~500 students  ->  10
#   ~2000 students ->  30   (also raise RATE_LIMIT_GLOBAL_PER_MIN)
MAX_INSTANCES=10

# Keep this many instances warm. 0 = scale to zero (free when idle, but the
# first student of the day waits ~40s for a cold start).
# Set to 1 shortly before class and back to 0 afterwards:
#   ./scripts/warm.sh on | off
MIN_INSTANCES=0

# Per-instance resources. 2 CPU / 2Gi comfortably runs 2 verifier workers,
# each holding the ~600MB model.
CPU=2
MEMORY=2Gi
FACE_WORKER_COUNT=2


# ── Face verification thresholds ─────────────────────────────────────

# TODO(enrollment): these are NOT calibrated for your cohort yet.
#
# The current 67-image gallery has one colliding pair at 0.50
# (25BRS1169 / 25BRS1286 score 0.5016 against each other — they can mark
# each other present). 0.55 gives zero collisions in that gallery.
#
# After collecting the new multi-image dataset, run:
#   npm run verify:gallery
# and replace these with the values it recommends.
FACE_THRESHOLD_ACCEPT=0.55
FACE_THRESHOLD_REVIEW=0.45


# ── Rate limiting ────────────────────────────────────────────────────

# Backstop requests/minute per IP. A whole classroom is behind ONE NAT'd IP,
# so size this for the class, not for a person: roughly students x 5.
# 6000 covers ~500 students arriving inside the same minute.
RATE_LIMIT_GLOBAL_PER_MIN=6000
