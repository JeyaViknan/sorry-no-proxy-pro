# ════════════════════════════════════════════════════════════════════
#  Deployment configuration
#
#    cp deploy.env.example deploy.env
#
#  Two paths. Pick ONE and fill in that section.
#
#    A) FREE      Hugging Face Spaces + Cloudflare Pages   (no credit card)
#    B) BILLED    Google Cloud Run + Cloud Storage         (card required)
#
#  Path A is the default and is what docs/DEPLOYMENT.md walks through.
#  deploy.env is gitignored and holds no secrets — real secrets live in the
#  host's own secret store.
# ════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════
#  A) FREE PATH — Hugging Face Spaces
# ════════════════════════════════════════════════════════════════════

# Your Hugging Face username (https://huggingface.co/settings/profile).
HF_USERNAME=your-hf-username

# The Space that runs the backend + student scanner. Created at
# https://huggingface.co/new-space with SDK = Docker, visibility = PUBLIC.
# Public is required: students must be able to open the scanner.
HF_SPACE_NAME=snp-attendance

# A PRIVATE dataset repo holding gallery/face_db.npz.
# Private is not negotiable — this is derived biometric data.
# Created at https://huggingface.co/new-dataset
GALLERY_DATASET=snp-gallery


# ════════════════════════════════════════════════════════════════════
#  Faculty portal — Cloudflare Pages (free, both paths)
# ════════════════════════════════════════════════════════════════════

# Cloudflare Pages project name. The URL becomes <name>.pages.dev
PAGES_PROJECT=snp-faculty

# Fill in AFTER the first Pages deploy, then add it to ALLOWED_ORIGINS on the
# backend host. The backend rejects any origin it has not been told about.
FACULTY_ORIGIN=


# ════════════════════════════════════════════════════════════════════
#  Attendance export — pick ONE (or neither)
# ════════════════════════════════════════════════════════════════════
#
# Both are optional. Without either, attendance is still recorded server-side
# and downloadable as CSV from the faculty portal.

# ── Option 1: Apps Script webhook (recommended — no cloud project) ───
# Paste scripts/apps-script/Code.gs into your sheet's Apps Script editor and
# deploy it as a web app. Setup takes about five minutes and needs nothing
# beyond a Google account.
#
# These go on the SPACE, not here — listed for reference:
#   SHEET_WEBHOOK_URL     https://script.google.com/macros/s/..../exec
#   SHEET_WEBHOOK_SECRET  the same long random string as in Code.gs

# ── Option 2: Sheets API (needs a Google Cloud project) ──────────────
# Only if your institution already uses Google Cloud. Requires a service
# account, and Google may prompt for billing while enabling the API.
#   SHEET_ID              from the spreadsheet URL
#   SHEET_RANGE           Attendance!A:G


# ════════════════════════════════════════════════════════════════════
#  Face verification thresholds
# ════════════════════════════════════════════════════════════════════

# 0.55, NOT 0.50. In the current 67-student gallery, 25BRS1169 and 25BRS1286
# score 0.5016 against each other — at 0.50 each can mark the other present.
# 0.55 gives zero colliding pairs.
#
# TODO(enrollment): after collecting multi-image enrollment data, run
#   npm run verify:gallery
# and replace both with the values it recommends.
FACE_THRESHOLD_ACCEPT=0.55
FACE_THRESHOLD_REVIEW=0.45

# Verifier processes. Each holds the model in memory.
# MEASURED: 1 worker ≈ 564MB, 2 workers ≈ 790MB.
# Hugging Face free tier gives 16GB, so 2 is comfortable.
FACE_WORKER_COUNT=2

# Backstop requests/minute per IP. A whole classroom shares ONE NAT'd IP, so
# size this for the class, not for a person: roughly students x 5.
RATE_LIMIT_GLOBAL_PER_MIN=6000


# ════════════════════════════════════════════════════════════════════
#  B) BILLED PATH — Google Cloud Run  (leave blank if using path A)
# ════════════════════════════════════════════════════════════════════
#
# Only needed if you run ./scripts/setup-gcp.sh and ./scripts/deploy-backend.sh.
# See docs/DEPLOYMENT-GCP.md.

# GCP_PROJECT_ID=my-attendance-project
# GCP_REGION=asia-south1
# SERVICE_NAME=snp-attendance
# GCS_BUCKET=yourname-snp-gallery
# SA_NAME=snp-runtime
# MAX_INSTANCES=10
# MIN_INSTANCES=0
# CPU=2
# MEMORY=2Gi
