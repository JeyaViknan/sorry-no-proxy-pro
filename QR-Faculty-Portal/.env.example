# Faculty portal build configuration.
#
# Vite inlines import.meta.env at BUILD time, so this is not a runtime setting:
# changing the backend URL requires a rebuild and redeploy.
#
# Leave BLANK for local development — vite.config.js proxies /api to
# http://localhost:7860, so the dev server needs no configuration.
#
# For production, ./scripts/deploy-faculty.sh sets this automatically from
# your Cloud Run service. Set it by hand only if you deploy some other way.
VITE_API_BASE=
