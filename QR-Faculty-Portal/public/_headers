# Cloudflare Pages headers for the faculty portal.
#
# The backend sets its own headers via helmet; Pages serves static files only,
# so these have to be declared here.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # connect-src must allow the Cloud Run backend. `https:` is deliberately
  # broad here rather than hardcoding a URL that changes between deploys —
  # the portal only ever talks to the origin baked into its bundle, and the
  # backend's own CORS allow-list is the control that actually matters.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'

# Vite emits content-hashed asset filenames, so they can cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point must always revalidate, or a fix cannot reach a projector
# machine that already has the page cached.
/index.html
  Cache-Control: no-cache, must-revalidate
