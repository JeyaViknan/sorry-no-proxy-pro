# ────────────────────────────────────────────────────────────────────
# Sorry No Proxy — configuration template
#
#   cp .env.example .env    then fill in the real values.
#   NEVER commit .env. Generate secrets with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=7860

# ── Secrets (REQUIRED — server refuses to start without these) ───────
# Signs the rotating QR payloads the faculty display shows. Rotating this
# instantly invalidates every QR in circulation.
QR_SIGNING_SECRET=

# Signs the short-lived attendance tokens issued after a valid QR scan.
# Keep separate from QR_SIGNING_SECRET so compromising one does not
# grant the ability to mint the other.
TOKEN_SIGNING_SECRET=

# Shared passphrase a faculty member enters to start a session.
# Minimum 12 characters. Change per semester.
FACULTY_ACCESS_CODE=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API.
# The old `origin: "*"` let any website on the internet post attendance.
# Include the faculty app origin and the scanner origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:7860

# ── Google Sheets (optional — attendance still records without it) ───
# If left blank the server logs attendance locally and skips the Sheets
# write, so a Sheets outage can never block a class.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full key. Literal \n sequences are converted to newlines.
GOOGLE_PRIVATE_KEY=
SHEET_ID=
SHEET_RANGE=Attendance!A:G

# ── QR protocol timing ───────────────────────────────────────────────
# How long a single signed QR payload stays valid, in milliseconds.
# Lower = harder to relay a screenshot to someone outside the room.
# Must exceed the faculty display's rotation interval, plus clock skew.
QR_TOKEN_TTL_MS=4000
# Tolerated clock difference between server and faculty device.
QR_CLOCK_SKEW_MS=2000
# How long a student has to complete face capture after a valid scan.
ATTENDANCE_TOKEN_TTL_MS=120000

# ── Face verification ────────────────────────────────────────────────
# Auto-accept at or above this cosine similarity.
# TODO(enrollment): recalibrate empirically once the new gallery exists.
#   Run: npm run verify:gallery -- --calibrate
FACE_THRESHOLD_ACCEPT=0.50
# Between REVIEW and ACCEPT: attendance is recorded but flagged for
# faculty review rather than rejected outright.
FACE_THRESHOLD_REVIEW=0.42
# Max verification attempts per registration number per session.
FACE_MAX_ATTEMPTS=3

# ── Paths / runtime ──────────────────────────────────────────────────
PYTHON_BIN=python3
GALLERY_DIR=./gallery
# Number of persistent Python verifier processes. Each holds the model
# in memory (~600MB). Set to (vCPU count) on a dedicated instance.
FACE_WORKER_COUNT=1
