# ────────────────────────────────────────────────────────────────────
# Sorry No Proxy — configuration template
#
#   cp .env.example .env    then fill in the real values.
#   NEVER commit .env. Generate secrets with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=7860

# ── Secrets (REQUIRED — server refuses to start without these) ───────
# Signs the rotating QR payloads the faculty display shows. Rotating this
# instantly invalidates every QR in circulation.
QR_SIGNING_SECRET=

# Signs the short-lived attendance tokens issued after a valid QR scan.
# Keep separate from QR_SIGNING_SECRET so compromising one does not
# grant the ability to mint the other.
TOKEN_SIGNING_SECRET=

# Shared passphrase a faculty member enters to start a session.
# Minimum 12 characters. Change per semester.
FACULTY_ACCESS_CODE=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API.
# The old `origin: "*"` let any website on the internet post attendance.
# Include the faculty app origin and the scanner origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:7860

# ── Google Sheets (optional — attendance still records without it) ───
# If left blank the server logs attendance locally and skips the Sheets
# write, so a Sheets outage can never block a class.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full key. Literal \n sequences are converted to newlines.
GOOGLE_PRIVATE_KEY=
SHEET_ID=
SHEET_RANGE=Attendance!A:G

# ── QR protocol timing ───────────────────────────────────────────────
# How long a single signed QR payload stays valid, in milliseconds.
# Lower = harder to relay a screenshot to someone outside the room.
# Must exceed the faculty display's rotation interval, plus clock skew.
QR_TOKEN_TTL_MS=4000
# Tolerated clock difference between server and faculty device.
QR_CLOCK_SKEW_MS=2000
# How long a student has to complete face capture after a valid scan.
ATTENDANCE_TOKEN_TTL_MS=120000

# ── Face verification ────────────────────────────────────────────────
# Auto-accept at or above this cosine similarity.
# TODO(enrollment): recalibrate empirically once the new gallery exists.
#   Run: npm run verify:gallery -- --calibrate
FACE_THRESHOLD_ACCEPT=0.50
# Between REVIEW and ACCEPT: attendance is recorded but flagged for
# faculty review rather than rejected outright.
FACE_THRESHOLD_REVIEW=0.42
# Max verification attempts per registration number per session.
FACE_MAX_ATTEMPTS=3

# ── Rate limiting ────────────────────────────────────────────────────
# Backstop requests/minute per IP. A whole classroom shares ONE NAT'd IP, so
# this must be sized for the class, not for one person: roughly
# (students x 5 requests). Default 6000 covers ~500 students in a single
# minute. Per-device limits (not configurable) are the real fairness control.
RATE_LIMIT_GLOBAL_PER_MIN=6000

# ── Gallery ──────────────────────────────────────────────────────────
# Where the face embeddings live on disk.
GALLERY_DIR=./gallery

# Optional: fetch gallery/face_db.npz from Cloud Storage at startup instead of
# expecting it on disk. This is how production works — the embeddings never
# enter the container image, and updating them is a single file upload.
#
# Format: gs://bucket-name/object-name
# The service account must have roles/storage.objectViewer on the bucket.
# Set automatically by ./scripts/deploy-backend.sh. Leave blank locally.
GALLERY_GCS_URI=

# ── Paths / runtime ──────────────────────────────────────────────────
PYTHON_BIN=python3
# Number of persistent Python verifier processes. Each holds the model
# in memory (~600MB). Set to (vCPU count) on a dedicated instance.
FACE_WORKER_COUNT=1


# ════════════════════════════════════════════════════════════════════
#  Advanced tuning — all optional, sensible defaults shown.
#  You should not need to touch these. Documented so nothing the code
#  reads is invisible.
# ════════════════════════════════════════════════════════════════════

# How long a student session stays live (ms). Default 3 hours.
SESSION_TTL_MS=10800000

# How far ahead the faculty display may prefetch signed QR payloads (ms).
# Larger = fewer round trips on flaky wifi, but a leaked batch stays useful
# for longer.
QR_MAX_BATCH_SPAN_MS=60000

# Burst frames accepted per submission (1-5). The client sends the sharpest
# frames first and the server stops early on the first accept.
FACE_MAX_FRAMES=3

# Per-frame upload ceiling in bytes. A 720p JPEG at q0.88 is ~120KB.
FACE_MAX_FRAME_BYTES=409600

# How long the server waits for one verification before giving up (ms).
FACE_REQUEST_TIMEOUT_MS=20000

# How often queued attendance rows are flushed to Google Sheets (ms).
SHEET_FLUSH_INTERVAL_MS=5000

# Registration number format, as a JavaScript regular expression.
# Default matches 25BCE1276 — two digits, three letters, four digits.
# Change this if your institution uses a different scheme; the scanner's
# client-side check in public/js/app.js must be changed to match.
REGISTER_NUMBER_PATTERN=^[0-9]{2}[A-Z]{3}[0-9]{4}$
